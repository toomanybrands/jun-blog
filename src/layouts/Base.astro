---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import SearchBox from '../components/SearchBox.astro';
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.name, description = SITE.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ko" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      crossorigin
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v2.3.3/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <title>{title}</title>
    <script is:inline>
      // 렌더링 전에 테마를 적용해 번개(flashing)를 방지
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch (e) {}
        var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
        document.documentElement.dataset.theme = saved || (prefersLight ? 'light' : 'dark');
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="site-title" href="/">{SITE.name}</a>
        <div class="header-nav">
          <SearchBox />
          <nav>
            <a href="/tags">태그</a>
          </nav>
          <ThemeToggle />
        </div>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        © {new Date().getFullYear()} {SITE.author} · Built with
        <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>
      </div>
    </footer>
  </body>
</html>
