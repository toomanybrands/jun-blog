---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import SearchBox from '../components/SearchBox.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.name, description = SITE.description } = Astro.props;
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const canonical = new URL(Astro.url.pathname, Astro.site);
const pad = (n: number) => String(n).padStart(2, '0');
---

<!doctype html>
<html lang="ko" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Noto+Sans+KR:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      // 렌더링 전에 테마를 적용해 번개(flashing)를 방지
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch (e) {}
        var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
        document.documentElement.dataset.theme = saved || (prefersLight ? 'light' : 'dark');
      })();
    </script>
  </head>
  <body>
    <!-- 고정 인덱스(좌측) -->
    <aside class="site-index">
      <span class="index-label">Index</span>
      <ul class="index-list">
        <li>
          <a href="/#info"><span class="idx">00.</span><span class="it">소개</span></a>
        </li>
        {posts.map((post, i) => (
          <li>
            <a href={`/#post-${i + 1}`}>
              <span class="idx">{pad(i + 1)}.</span>
              <span class="it">{post.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="index-search">
        <SearchBox />
      </div>
    </aside>

    <!-- 우측 콘텐츠 열 -->
    <main class="content-col">
      <slot />
    </main>

    <!-- 고정 푸터: 시계 + 이름 + 테마 전환 -->
    <footer class="site-footer">
      <div class="footer-left">
        <span class="clock" id="clock">--:--:--</span>
        <span>{SITE.name}</span>
        <a href="/write/" class="footer-write">쓰기</a>
      </div>
      <ThemeToggle />
    </footer>

    <script is:inline>
      // 푸터 라이브 시계 (참고 사이트와 동일)
      (function () {
        function tick() {
          var el = document.getElementById('clock');
          if (!el) return;
          var d = new Date();
          el.textContent = [d.getHours(), d.getMinutes(), d.getSeconds()]
            .map(function (n) { return String(n).padStart(2, '0'); })
            .join(':');
        }
        tick();
        setInterval(tick, 1000);
      })();

      // 인덱스 클릭 → 같은 페이지면 부드럽게 스크롤, 아니면 이동
      (function () {
        document.querySelectorAll('.index-list a').forEach(function (a) {
          a.addEventListener('click', function (e) {
            var href = a.getAttribute('href') || '';
            var target = null;
            try {
              target = new URL(href, location.href);
            } catch (err) {
              return;
            }
            if (target.pathname !== location.pathname) return; // 다른 페이지 → 브라우저 기본 동작
            var hash = target.hash;
            if (!hash) return;
            e.preventDefault();
            var el = document.querySelector(hash);
            if (el) {
              history.pushState(null, '', hash);
              el.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          });
        });
      })();
    </script>
  </body>
</html>
