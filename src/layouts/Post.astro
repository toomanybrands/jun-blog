---
// 개별 글 페이지 (홈과 동일한 프로젝트 섹션 스타일)
import Base from './Base.astro';
import Giscus from '../components/Giscus.astro';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { SITE } from '../config';

interface Props {
  post: CollectionEntry<'posts'>;
  index: number; // 1부터 시작 (최신 = 1)
  total: number;
  prev?: CollectionEntry<'posts'>; // 더 오래된 글
  next?: CollectionEntry<'posts'>; // 더 새로운 글
}

const { post, index, total, prev, next } = Astro.props;
const { Content } = await render(post);
const pad = (n: number) => String(n).padStart(2, '0');
const fmt = (d: Date) =>
  d.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
const chars = (body?: string) => (body || '').replace(/[#*`>\[\]!|-]/g, '').replace(/\s+/g, '').length;
---

<Base
  title={`${post.data.title} · ${SITE.name}`}
  description={post.data.description}
>
  <section id={`post-${index}`} class="project">
    <span class="num">{pad(index)}.</span>
    <div class="proj-main">
      <div class="proj-top">
        <h2>{post.data.title}</h2>
        <span class="col-label">작성일</span>
      </div>
      <div class="meta2">
        <span>
          {fmt(post.data.pubDate)}
          <br />
          <a href={`/categories/${encodeURIComponent(post.data.category)}`}>{post.data.category}</a>
        </span>
        <span>
          {post.data.tags.map((t) => (
            <a href={`/tags/${encodeURIComponent(t)}`}>
              #{t}{' '}
            </a>
          ))}
          <br />
          {chars(post.body)}자
          {post.data.updatedDate ? (
            <>
              <br />
              수정 {fmt(post.data.updatedDate)}
            </>
          ) : null}
        </span>
      </div>
      <div class="proj-body prose">
        <Content />
        <Giscus />
      </div>
    </div>
  </section>

  {prev || next ? (
    <nav class="post-nav">
      {prev ? (
        <a href={`/posts/${prev.id}/`}>
          <span class="num">← {pad(index + 1)}.</span>
          <span class="nav-title">{prev.data.title}</span>
        </a>
      ) : (
        <span></span>
      )}
      {next ? (
        <a class="next" href={`/posts/${next.id}/`}>
          <span class="num">{pad(index - 1)}.</span>
          <span class="nav-title">{next.data.title} →</span>
        </a>
      ) : (
        <span></span>
      )}
    </nav>
  ) : null}
</Base>
