---
// 글 목록 항목 (번호 인덱스)
interface Post {
  id: string;
  data: {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    category: string;
    tags: string[];
    draft: boolean;
  };
}

interface Props {
  post: Post;
  index: number; // 1부터
}

const { post, index } = Astro.props;
const date = post.data.pubDate.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<li class="post-entry">
  <span class="num">{String(index).padStart(2, '0')}.</span>
  <div class="entry-main">
    <h2 class="title"><a href={`/posts/${post.id}/`}>{post.data.title}</a></h2>
    <div class="meta">
      <span>{date}</span>
      <a href={`/categories/${encodeURIComponent(post.data.category)}`}>{post.data.category}</a>
      {post.data.tags.map((tag) => (
        <a href={`/tags/${encodeURIComponent(tag)}`}>#{tag}</a>
      ))}
    </div>
  </div>
</li>
