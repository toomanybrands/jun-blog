---
// 글 목록 행 (번호 인덱스 + 제목 + 메타)
interface Post {
  id: string;
  data: {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    category: string;
    tags: string[];
    draft: boolean;
  };
}

interface Props {
  post: Post;
  index: number; // 홈 전체 순서 기준 1부터
}

const { post, index } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const date = post.data.pubDate.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<li class="project">
  <span class="num">{pad(index)}.</span>
  <div class="proj-main">
    <div class="proj-top">
      <h2>
        <a href={`/#post-${index}`}>{post.data.title}</a>
      </h2>
      <span class="col-label">작성일</span>
    </div>
    <div class="meta2">
      <span>
        {date}
        <br />
        <a href={`/categories/${encodeURIComponent(post.data.category)}`}>{post.data.category}</a>
      </span>
      <span>
        {post.data.tags.map((tag) => (
          <a href={`/tags/${encodeURIComponent(tag)}`}>
            #{tag}{' '}
          </a>
        ))}
      </span>
    </div>
  </div>
</li>
