---
// Pagefind 기반 전역 검색
---

<div class="search" id="pagefind-ui"></div>
<script src="/pagefind/pagefind-ui.js" is:inline></script>

<script>
  const el = document.getElementById('pagefind-ui');

  if (el && !el.dataset.initialized) {
    el.dataset.initialized = 'true';

    const init = () => {
      const PF = (window as any).PagefindUI;
      if (!PF) return; // pagefind-ui.js가 아직 없으면 (빌드 전 dev 모드 등) 조용히 스킵
      const app = new PF({
        element: '#pagefind-ui',
        showSubResults: true,
        searchRoot: '/',
        translateStrings: {
          button: '닫기',
          clear_button: '지우기',
          no_results: '결과가 없어요',
          placeholder: '블로그 검색…',
        },
      });
      (window as any).__pagefind = app;
    };

    if (document.readyState === 'complete') init();
    else window.addEventListener('load', init);
  }

  // 테마 전환 시 검색 UI 테마도 함께 변경
  window.addEventListener('themechange', (e: CustomEvent<string>) => {
    const app = (window as any).__pagefind;
    app?.setTheme?.(e.detail === 'dark' ? 'dark' : 'light');
  });
</script>
