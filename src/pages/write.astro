---
// 모바일 글쓰기 페이지 — GitHub Contents API 로 직접 리포에 커밋
import { getCollection } from 'astro:content';
import { SITE } from '../config';

const categories = [...new Set((await getCollection('posts', ({ data }) => !data.draft)).map((p) => p.data.category))];
const cats = categories.join(',');
---

<!doctype html>
<html lang="ko" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>쓰기 · {SITE.name}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Noto+Sans+KR:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        var saved = null;
        try { saved = localStorage.getItem('theme'); } catch (e) {}
        var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
        document.documentElement.dataset.theme = saved || (prefersLight ? 'light' : 'dark');
      })();
    </script>
    <style>
      :root, [data-theme='light'] {
        --bg: #fff; --fg: #000; --fg-85: rgba(0,0,0,.85); --fg-75: rgba(0,0,0,.75);
        --fg-40: rgba(0,0,0,.4); --border: rgba(0,0,0,.18);
      }
      [data-theme='dark'] {
        --bg: #000; --fg: #fff; --fg-85: rgba(255,255,255,.85); --fg-75: rgba(255,255,255,.75);
        --fg-40: rgba(255,255,255,.4); --border: rgba(255,255,255,.22);
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--bg); color: var(--fg);
        font-family: 'Inter', 'Noto Sans KR', 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif;
        font-size: 14.5px; line-height: 1.6;
      }
      a { color: inherit; text-decoration: none; }
      .wrap { max-width: 640px; margin: 0 auto; padding: 0 20px 80px; }
      .topbar {
        position: sticky; top: 0; background: var(--bg); z-index: 10;
        display: flex; align-items: center; gap: 16px;
        padding: 18px 0 14px; border-bottom: 1px solid var(--border);
      }
      .topbar .t { font-size: 15px; font-weight: 500; color: var(--fg-85); }
      .topbar .repo { font-size: 12px; color: var(--fg-40); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .topbar .right { margin-left: auto; display: flex; gap: 10px; align-items: center; }
      .toggle {
        width: 12px; height: 12px; padding: 0; background: var(--fg); border: none; cursor: pointer;
      }
      .btn {
        font: inherit; font-size: 14px; color: var(--fg-85); background: none;
        border: 1px solid var(--border); padding: 10px 18px; cursor: pointer; min-height: 44px;
      }
      .btn:hover { border-color: var(--fg-85); }
      .btn.primary { background: var(--fg); color: var(--bg); border-color: var(--fg); }
      .btn.danger { color: var(--fg-85); }
      .btn:disabled { opacity: .4; cursor: not-allowed; }
      .sec { padding: 28px 0; border-bottom: 1px solid var(--border); }
      .sec:last-child { border-bottom: none; }
      .label { display: block; font-size: 13px; color: var(--fg-40); margin: 0 0 8px; }
      .row { display: flex; gap: 12px; align-items: flex-start; }
      .row > * { flex: 1; min-width: 0; }
      input[type='text'], input[type='date'], input[type='password'], textarea {
        width: 100%; font: inherit; font-size: 16px; color: var(--fg);
        background: transparent; border: none; border-bottom: 1px solid var(--border);
        padding: 8px 0; outline: none; -webkit-appearance: none; border-radius: 0;
      }
      input:focus, textarea:focus { border-bottom-color: var(--fg-85); }
      textarea { min-height: 44vh; line-height: 1.7; resize: vertical; font-family: inherit; }
      .hint { font-size: 12px; color: var(--fg-40); margin-top: 8px; line-height: 1.6; }
      .post-row {
        display: flex; align-items: center; gap: 12px; padding: 12px 0;
        border-bottom: 1px solid var(--border);
      }
      .post-row:last-child { border-bottom: none; }
      .post-row .num { font-size: 12px; color: var(--fg-40); width: 30px; flex-shrink: 0; font-variant-numeric: tabular-nums; }
      .post-row .tt { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 15px; color: var(--fg-85); }
      .post-row .tt .draft { color: var(--fg-40); font-size: 12px; margin-left: 6px; }
      .post-row .acts { display: flex; gap: 4px; flex-shrink: 0; }
      .post-row .acts button {
        font: inherit; font-size: 12px; background: none; border: none; color: var(--fg-40);
        padding: 10px 8px; cursor: pointer; min-height: 44px;
      }
      .post-row .acts button:hover { color: var(--fg-85); }
      .phos { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
      .pho { position: relative; width: 84px; }
      .pho img { width: 84px; height: 84px; object-fit: cover; display: block; border: 1px solid var(--border); }
      .pho .x {
        position: absolute; top: -8px; right: -8px; width: 24px; height: 24px;
        background: var(--bg); border: 1px solid var(--border); color: var(--fg-85);
        font-size: 12px; line-height: 1; cursor: pointer; padding: 0;
      }
      .pho .no { position: absolute; top: 34px; left: 26px; font-size: 12px; color: #fff; text-shadow: 0 0 6px #000; }
      .status { font-size: 13px; margin-top: 14px; min-height: 18px; line-height: 1.6; }
      .status.ok { color: var(--fg-85); }
      .status.err { color: #d33; }
      [data-theme='dark'] .status.err { color: #f66; }
      .hidden { display: none !important; }
      .check { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--fg-85); margin-top: 16px; }
      .check input { width: 18px; height: 18px; accent-color: var(--fg); }
      .file-add {
        font: inherit; font-size: 14px; color: var(--fg-85); background: none;
        border: 1px dashed var(--border); padding: 10px 16px; cursor: pointer; min-height: 44px;
      }
      .file-add:hover { border-color: var(--fg-85); }
      input[type='file'] { display: none; }
      .actions { display: flex; gap: 12px; margin-top: 24px; }
      .actions .btn { flex: 1; }
      code { border: 1px solid var(--border); padding: 1px 5px; font-size: .85em; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="topbar">
        <a href="/" class="t">← 홈</a>
        <span class="t">쓰기</span>
        <span class="repo" id="repoLabel"></span>
        <div class="right">
          <button class="btn hidden" id="cfgBtn" type="button">설정</button>
          <button class="toggle" id="themeToggle" type="button" aria-label="테마 변경"></button>
        </div>
      </div>

      <!-- 설정 (리포 + 토큰) -->
      <section class="sec" id="cfgSection">
        <p class="hint" style="margin-top:0">
          GitHub <b>fine-grained personal access token</b>이 필요합니다.<br />
          github.com → Settings → Developer settings → Personal access tokens →
          <b>Fine-grained tokens</b> → Create: 리포는 이 블로그 리포만 선택하고,
          permission은 <code>Contents: Read and write</code>만 체크.
          토큰은 이 브라우저(localStorage)에만 저장되고 api.github.com으로만 전송됩니다.
        </p>
        <div class="row" style="margin-top:18px">
          <div>
            <label class="label" for="cfgRepo">GitHub 리포 (owner/repo)</label>
            <input type="text" id="cfgRepo" placeholder="jun/jun-blog" autocomplete="off" />
          </div>
          <div>
            <label class="label" for="cfgBranch">브랜치</label>
            <input type="text" id="cfgBranch" placeholder="main" autocomplete="off" />
          </div>
        </div>
        <div style="margin-top:16px">
          <label class="label" for="cfgToken">토큰</label>
          <input type="password" id="cfgToken" placeholder="github_pat_..." autocomplete="off" />
        </div>
        <div class="actions">
          <button class="btn primary" id="cfgSave" type="button">저장</button>
        </div>
        <div class="status" id="cfgStatus"></div>
      </section>

      <!-- 기존 글 목록 -->
      <section class="sec hidden" id="listSection">
        <div class="row" style="align-items:center">
          <span class="t" style="font-size:15px;font-weight:500;color:var(--fg-85);flex:1">글 목록</span>
          <button class="btn primary" id="newBtn" type="button">+ 새 글</button>
        </div>
        <div id="postList" style="margin-top:16px"></div>
        <div class="hint">삭제는 GitHub 리포의 파일까지 지웁니다.</div>
      </section>

      <!-- 에디터 -->
      <section class="sec hidden" id="editorSection">
        <div id="editingLabel" style="font-size:13px;color:var(--fg-40);margin-bottom:16px"></div>

        <div style="margin-bottom:20px">
          <label class="label" for="fTitle">제목</label>
          <input type="text" id="fTitle" placeholder="오늘의 제목" autocomplete="off" />
        </div>

        <div class="row" style="margin-bottom:20px">
          <div>
            <label class="label" for="fDate">날짜</label>
            <input type="date" id="fDate" />
          </div>
          <div>
            <label class="label" for="fCat">카테고리</label>
            <input type="text" id="fCat" list="catList" placeholder="일상" autocomplete="off" />
            <datalist id="catList"></datalist>
          </div>
        </div>

        <div style="margin-bottom:20px">
          <label class="label" for="fTags">태그 (쉼표로 구분)</label>
          <input type="text" id="fTags" placeholder="일기, 메모" autocomplete="off" />
        </div>

        <div style="margin-bottom:20px">
          <label class="label">사진</label>
          <button class="file-add" id="photoBtn" type="button">+ 사진 추가 (갤러리)</button>
          <input type="file" id="photoInput" accept="image/*" multiple />
          <div class="pho" id="photoBox"></div>
          <p class="hint">
            본문에 <code>{"{사진}"}</code> 을 넣고 싶은 위치에 쓰면, 추가한 순서대로
            사진 1, 사진 2… 로 들어갑니다. 남은 사진은 글 끝에 붙습니다.
            (자동으로 압축됩니다)
          </p>
        </div>

        <div style="margin-bottom:8px">
          <label class="label" for="fBody">본문 (Markdown)</label>
          <textarea id="fBody" placeholder="오늘 하루를 적어보세요.&#10;&#10;## 소제목&#10;- 목록도 되고&#10;- [사진] 위치에 사진이 들어가요"></textarea>
        </div>

        <label class="check">
          <input type="checkbox" id="fDraft" />
          임시 보관(draft) — 체크하면 사이트에 안 보임
        </label>

        <div class="actions">
          <button class="btn" id="cancelBtn" type="button">취소</button>
          <button class="btn primary" id="saveBtn" type="button">저장 (GitHub push)</button>
        </div>
        <div class="status" id="saveStatus"></div>
      </section>
    </div>

    <script is:inline>
      (function () {
        'use strict';
        var LS_KEY = 'write_cfg_v1';
        var photos = []; // [{dataUrl, size}]
        var editing = null; // {id, path} | null(신규)
        var cfg = null;
        try { cfg = JSON.parse(localStorage.getItem(LS_KEY)); } catch (e) {}

        var $ = function (id) { return document.getElementById(id); };
        var repoLabel = $('repoLabel'), cfgSection = $('cfgSection'), listSection = $('listSection'),
            editorSection = $('editorSection'), cfgBtn = $('cfgBtn');

        // ---------- 테마 ----------
        $('themeToggle').addEventListener('click', function () {
          var next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
        });

        // ---------- 유틸 ----------
        function esc(s) {
          return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }
        function yamlQuote(s) {
          return '"' + String(s).replace(/\\/g, '\\\\').replace(/"/g, '\\"').replace(/\n/g, ' ').slice(0, 200) + '"';
        }
        function slugify(title) {
          var ascii = title.normalize('NFKD').replace(/[^a-zA-Z0-9]+/g, ' ').trim().toLowerCase().replace(/ +/g, '-');
          if (ascii) return ascii;
          var d = new Date(), p = function (n) { return String(n).padStart(2, '0'); };
          return 'post-' + d.getFullYear() + p(d.getMonth() + 1) + p(d.getDate()) + '-' + p(d.getHours()) + p(d.getMinutes());
        }
        function blobToB64(blob) {
          return new Promise(function (res, rej) {
            var fr = new FileReader();
            fr.onload = function () { res(String(fr.result).split(',')[1]); };
            fr.onerror = rej;
            fr.readAsDataURL(blob);
          });
        }
        // 큰 파일도 안전하도록 청크 분리 (apply 인자 개수 한계 회피)
        function strToB64(str) {
          var bytes = new TextEncoder().encode(str);
          var s = '', CH = 0x8000;
          for (var i = 0; i < bytes.length; i += CH) {
            s += String.fromCharCode.apply(null, bytes.subarray(i, i + CH));
          }
          return btoa(s);
        }
        function encPath(p) {
          return p.split('/').map(encodeURIComponent).join('/');
        }

        // ---------- 설정 ----------
        function applyCfg() {
          if (cfg && cfg.repo && cfg.token) {
            repoLabel.textContent = cfg.repo + ' (' + (cfg.branch || 'main') + ')';
            cfgBtn.classList.remove('hidden');
            cfgSection.classList.add('hidden');
            loadList();
          } else {
            cfgSection.classList.remove('hidden');
            if (cfg) {
              $('cfgRepo').value = cfg.repo || '';
              $('cfgBranch').value = cfg.branch || 'main';
              $('cfgToken').value = cfg.token || '';
            }
          }
        }
        $('cfgSave').addEventListener('click', function () {
          var repo = $('cfgRepo').value.trim();
          var token = $('cfgToken').value.trim();
          var branch = $('cfgBranch').value.trim() || 'main';
          if (!/^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/.test(repo)) {
            $('cfgStatus').textContent = '리포는 owner/repo 형태로 입력하세요.';
            return;
          }
          if (!token) { $('cfgStatus').textContent = '토큰을 입력하세요.'; return; }
          cfg = { repo: repo, token: token, branch: branch };
          try { localStorage.setItem(LS_KEY, JSON.stringify(cfg)); } catch (e) {}
          applyCfg();
        });
        cfgBtn.addEventListener('click', function () {
          cfgSection.classList.toggle('hidden');
        });

        // ---------- GitHub API ----------
        function api(path, opts) {
          var o = opts || {};
          return fetch('https://api.github.com' + path, {
            method: o.method || 'GET',
            headers: {
              Authorization: 'Bearer ' + cfg.token,
              Accept: 'application/vnd.github+json',
              'X-GitHub-Api-Version': '2022-11-28',
              'Content-Type': 'application/json'
            },
            body: o.body
          }).then(function (r) {
            if (r.status === 401 || r.status === 403) {
              throw new Error('토큰 오류 — 토큰이 만료되었거나 권한(Contents: Read and write)이 없어요. 설정에서 다시 확인하세요.');
            }
            if (!r.ok) {
              return r.json().catch(function () { return null; }).then(function (j) {
                throw new Error((j && j.message) || ('GitHub 오류 (' + r.status + ')'));
              });
            }
            return r.status === 204 ? null : r.json();
          });
        }

        // ---------- 글 목록 ----------
        var allPosts = [];
        function loadList() {
          fetch('/posts-index.json').then(function (r) { return r.json(); }).then(function (posts) {
            allPosts = posts;
            var box = $('postList');
            box.innerHTML = posts.map(function (p, i) {
              var d = new Date(p.pubDate);
              return '<div class="post-row">' +
                '<span class="num">' + String(i + 1).padStart(2, '0') + '.</span>' +
                '<span class="tt">' + esc(p.title) + (p.draft ? '<span class="draft">draft</span>' : '') +
                  '<br><span style="font-size:12px;color:var(--fg-40)">' +
                  d.getFullYear() + '년 ' + (d.getMonth() + 1) + '월 ' + d.getDate() + '일 · ' + esc(p.category) + '</span></span>' +
                '<span class="acts">' +
                '<button data-act="edit" data-id="' + esc(p.id) + '">수정</button>' +
                '<button data-act="del" data-id="' + esc(p.id) + '">삭제</button>' +
                '</span></div>';
            }).join('');
            listSection.classList.remove('hidden');
            $('catList').innerHTML = [...new Set(posts.map(function (p) { return p.category; }))].map(function (c) {
              return '<option value="' + esc(c) + '">';
            }).join('');
          }).catch(function () {
            $('postList').innerHTML = '<p class="hint">글 목록을 불러오지 못했어요. 새로고침해 보세요.</p>';
          });
        }

        // ---------- 에디터 ----------
        function openEditor(post) {
          editing = post ? { id: post.id } : null;
          $('editingLabel').textContent = post ? '수정 중 — ' + post.title : '새 글쓰기';
          $('fTitle').value = post ? post.title : '';
          $('fDate').value = post ? post.pubDate.slice(0, 10) : new Date().toISOString().slice(0, 10);
          $('fCat').value = post ? post.category : '';
          $('fTags').value = post ? post.tags.join(', ') : '';
          $('fDraft').checked = post ? !!post.draft : false;
          $('fBody').value = post ? (post.body || '') : '';
          photos = [];
          renderPhotos();
          $('saveStatus').textContent = '';
          editorSection.classList.remove('hidden');
          listSection.classList.add('hidden');
          cfgSection.classList.add('hidden');
          window.scrollTo(0, 0);
          setTimeout(function () { $('fTitle').focus(); }, 50);
        }

        function renderPhotos() {
          var box = $('photoBox');
          box.innerHTML = photos.map(function (p, i) {
            return '<div class="pho"><img src="' + p.dataUrl + '" alt="사진 ' + (i + 1) + '">' +
              '<span class="no">' + (i + 1) + '</span>' +
              '<button class="x" type="button" data-x="' + i + '" aria-label="삭제">×</button></div>';
          }).join('');
          box.querySelectorAll('.x').forEach(function (b) {
            b.addEventListener('click', function () {
              photos.splice(Number(b.dataset.x), 1);
              renderPhotos();
            });
          });
        }

        $('photoBtn').addEventListener('click', function () { $('photoInput').click(); });
        $('photoInput').addEventListener('change', function () {
          var files = [...$('photoInput').files];
          $('photoInput').value = '';
          var status = $('saveStatus');
          files.forEach(function (file) {
            if (!file.type || file.type.indexOf('image/') !== 0) return;
            compressImage(file).then(function (dataUrl) {
              photos.push({ dataUrl: dataUrl });
              renderPhotos();
              status.textContent = '';
              status.className = 'status';
            }).catch(function () {
              status.textContent = '“' + file.name + '” 을(를) 읽지 못했어요. HEIC 형식이면 사진 앱에서 JPEG로 저장한 뒤 다시 선택하세요.';
              status.className = 'status err';
            });
          });
        });

        function compressImage(file) {
          return createImageBitmap(file, { imageOrientation: 'from-image' }).then(function (bmp) {
            var MAX = 1600;
            var scale = Math.min(1, MAX / Math.max(bmp.width, bmp.height));
            var w = Math.max(1, Math.round(bmp.width * scale));
            var h = Math.max(1, Math.round(bmp.height * scale));
            var canvas = document.createElement('canvas');
            canvas.width = w; canvas.height = h;
            var ctx = canvas.getContext('2d');
            ctx.drawImage(bmp, 0, 0, w, h);
            bmp.close();
            return new Promise(function (res, rej) {
              canvas.toBlob(function (blob) {
                if (!blob) return rej(new Error('encode fail'));
                blobToB64(blob).then(function (b64) { res('data:image/jpeg;base64,' + b64); }, rej);
              }, 'image/jpeg', 0.82);
            });
          });
        }

        // ---------- 저장 ----------
        function buildMarkdown() {
          var title = $('fTitle').value.trim();
          var dateStr = $('fDate').value || new Date().toISOString().slice(0, 10);
          var cat = $('fCat').value.trim() || '일상';
          var tags = $('fTags').value.split(/[,，]/).map(function (s) { return s.trim(); }).filter(Boolean);
          var draft = $('fDraft').checked;
          var body = $('fBody').value;

          // {사진} 치환 (대소문자 무관)
          var rest = photos.slice();
          var replaced = body.replace(/\{\s*사진\s*\}/gi, function () {
            return rest.length ? '\n\n![사진](' + rest.shift().dataUrl + ')\n\n' : '';
          });
          if (rest.length) {
            replaced += '\n\n' + rest.map(function (p) { return '![사진](' + p.dataUrl + ')'; }).join('\n\n') + '\n';
          }

          var desc = body.replace(/\{\s*사진\s*\}/gi, ' ').replace(/[#*`>\[\]!|-]/g, ' ').replace(/!\[[^\]]*\]/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 120);
          var noon = new Date(dateStr + 'T12:00:00');
          var fm = [
            '---',
            'title: ' + yamlQuote(title),
            'description: ' + yamlQuote(desc || title),
            'pubDate: ' + noon.toISOString(),
            'category: ' + yamlQuote(cat),
            'tags: [' + tags.map(yamlQuote).join(', ') + ']',
            'draft: ' + (draft ? 'true' : 'false'),
            '---',
            ''
          ].join('\n');
          return fm + '\n' + replaced.trim() + '\n';
        }

        function pathFor(postId, title) {
          // 기존 글 id가 바로 src/content/posts/ 상대 경로
          if (postId) return 'src/content/posts/' + postId + (postId.endsWith('.md') || postId.endsWith('.mdoc') ? '' : '.md');
          var used = allPosts.map(function (p) { return p.id; });
          var slug = slugify(title);
          var candidate = slug, n = 2;
          while (used.indexOf(candidate) !== -1) candidate = slug + '-' + (n++);
          return 'src/content/posts/' + candidate;
        }

        $('saveBtn').addEventListener('click', function () {
          var title = $('fTitle').value.trim();
          if (!title) {
            var st = $('saveStatus');
            st.textContent = '제목을 입력하세요.';
            st.className = 'status err';
            return;
          }
          var btn = $('saveBtn');
          btn.disabled = true;
          btn.textContent = '푸시 중…';
          var st = $('saveStatus');
          st.textContent = 'GitHub에 푸시 중입니다…';
          st.className = 'status';

          var md = buildMarkdown();
          var b64 = strToB64(md);
          var path = pathFor(editing ? editing.id : null, title);

          api('/repos/' + cfg.repo + '/contents/' + encPath(path) + '?ref=' + cfg.branch)
            .then(function (j) { return { sha: j && j.sha }; })
            .catch(function (e) {
              if (String(e.message).indexOf('404') !== -1 || /Not Found/i.test(e.message)) return {};
              throw e;
            })
            .then(function (meta) {
              var payload = { content: b64, message: (editing ? '수정: ' : '신규: ') + title, branch: cfg.branch };
              if (meta.sha) payload.sha = meta.sha;
              return api('/repos/' + cfg.repo + '/contents/' + encPath(path), {
                method: 'PUT',
                body: JSON.stringify(payload)
              });
            })
            .then(function () {
              st.textContent = '저장 완료 — GitHub에 커밋됐어요. Vercel 재배포는 1~2분 걸리니 조금 뒤에 사이트를 새로고침해 보세요.';
              st.className = 'status ok';
              btn.textContent = '저장 (GitHub push)';
              openList();
            })
            .catch(function (e) {
              st.textContent = '저장 실패: ' + e.message;
              st.className = 'status err';
            })
            .finally(function () { btn.disabled = false; });
        });

        function openList() {
          editorSection.classList.add('hidden');
          cfgSection.classList.add('hidden');
          loadList();
        }
        $('cancelBtn').addEventListener('click', openList);

        // ---------- 목록 액션 ----------
        $('postList').addEventListener('click', function (e) {
          var b = e.target.closest('button[data-act]');
          if (!b) return;
          var post = allPosts.find(function (p) { return p.id === b.dataset.id; });
          if (!post) return;
          if (b.dataset.act === 'edit') {
            openEditor(post);
          } else if (b.dataset.act === 'del') {
            if (!confirm('“' + post.title + '” 글을 GitHub 리포에서 삭제할까요?')) return;
            var st = $('saveStatus');
            api('/repos/' + cfg.repo + '/contents/' + 'src/content/posts/' + post.id + (post.id.endsWith('.md') ? '' : '.md') + '?ref=' + cfg.branch)
              .then(function (j) {
                return api('/repos/' + cfg.repo + '/contents/' + 'src/content/posts/' + post.id + (post.id.endsWith('.md') ? '' : '.md') +
                  '?message=삭제: ' + encodeURIComponent(post.title) + '&sha=' + j.sha + '&branch=' + cfg.branch, { method: 'DELETE' });
              })
              .then(function () {
                alert('삭제했습니다.');
                openList();
              })
              .catch(function (err) { alert('삭제 실패: ' + err.message); });
          }
        });
        $('newBtn').addEventListener('click', function () { openEditor(null); });

        applyCfg();
      })();
    </script>
  </body>
</html>
